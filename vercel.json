{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://offszn-hu18.onrender.com/api/$1"
    },
    {
      "src": "/env.js",
      "dest": "https://offszn-hu18.onrender.com/env.js"
    },
    {
      "src": "/upload/(.*)",
      "dest": "https://offszn-hu18.onrender.com/upload/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "https://offszn-hu18.onrender.com/images/$1"
    },
    {
      "src": "/previews/(.*)",
      "dest": "https://offszn-hu18.onrender.com/previews/$1"
    },
    {
      "src": "/recursos/(.*)",
      "dest": "https://offszn-hu18.onrender.com/recursos/$1"
    },
    {
      "src": "/p/(.*)",
      "dest": "/producto.html"
    },
    {
      "src": "/beat/(.*)",
      "dest": "/producto.html"
    },
    {
      "src": "/drumkit/(.*)",
      "dest": "/producto.html"
    },
    {
      "src": "/loopkit/(.*)",
      "dest": "/producto.html"
    },
    {
      "src": "/recurso/(.*)",
      "dest": "/producto.html"
    },
    {
      "src": "/servicio/(.*)",
      "dest": "/servicio.html"
    },
    {
      "src": "/@(.*)",
      "dest": "/perfil-publico.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ]
}
