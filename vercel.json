{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://offszn-hu18.onrender.com/api/:match*"
    },
    {
      "source": "/env.js",
      "destination": "https://offszn-hu18.onrender.com/env.js"
    },
    {
      "source": "/upload/:match*",
      "destination": "https://offszn-hu18.onrender.com/upload/:match*"
    },
    {
      "source": "/images/:match*",
      "destination": "https://offszn-hu18.onrender.com/images/:match*"
    },
    {
      "source": "/previews/:match*",
      "destination": "https://offszn-hu18.onrender.com/previews/:match*"
    },
    {
      "source": "/recursos/:match*",
      "destination": "https://offszn-hu18.onrender.com/recursos/:match*"
    },
    {
      "source": "/p/:match*",
      "destination": "/producto.html"
    },
    {
      "source": "/beat/:match*",
      "destination": "/producto.html"
    },
    {
      "source": "/drumkit/:match*",
      "destination": "/producto.html"
    },
    {
      "source": "/loopkit/:match*",
      "destination": "/producto.html"
    },
    {
      "source": "/recurso/:match*",
      "destination": "/producto.html"
    },
    {
      "source": "/servicio/:match*",
      "destination": "/servicio.html"
    },
    {
      "source": "/@:username",
      "destination": "/perfil-publico.html"
    }
  ]
}
