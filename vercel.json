{
  "functions": {
    "api/index.js": {
      "includeFiles": "{_headers,*.html,favicon*,robots.txt,sitemap.xml,c*/**,script/**,libs/**,images/**,legal/**,owner/**,pages/**,plugin*/**,recursos/**,store-builder/**,upload/**,willie*/**,ayuda/**,server/**,music*/**}",
      "excludeFiles": "{**/*.mp4,**/*.wav,**/*.docx,**/*.psd,**/*.map}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
