{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.xml,server/public/**,willieinspired/**,crm/**}",
      "excludeFiles": "{node_modules/@ffmpeg-installer/**,**/*.wav,**/*.psd,**/*.pkg,plugins/**,videos/**,images/**,willieimages/**,downloads/**,cursos/**,music-raw-to-defined/**,music-star-chain/**,Carrusel_Instagram/**,scratch/**,server/tests/**,docs/**,**/*.md}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(index\\.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/plugins/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|script|images|willieimages|libs|components|recursos|videos|pages)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|woff2|woff|ttf|mp4|mp3|m4a)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(wp-admin.*|wp-login.*|wp-content.*|xmlrpc.*|.*\\.php|\\.env.*|\\.git.*)", "destination": "/404.html" },
    { "source": "/videos/(.*\\.mp4)", "destination": "/api/r2-public/videos/$1" },
    { "source": "/videos/omni-beat", "destination": "/api/r2-public/videos/omni-beat.mp4" },
    { "source": "/plugins/(.*\\.mp4)", "destination": "/api/r2-public/plugins/$1" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/register", "destination": "/pages/register.html" },
    { "source": "/cart", "destination": "/pages/cart.html" },
    { "source": "/product", "destination": "/producto" },
    { "source": "/recursos/x-flow-analyzer", "destination": "/plugins/x-flow-analyzer.html" },
    { "source": "/plugin/easy-mix", "destination": "/plugins/easy-mix.html" },
    { "source": "/plugins/easy-mix", "destination": "/plugins/easy-mix.html" },
    { "source": "/plugin/easy-pitch", "destination": "/plugins/easy-pitch.html" },
    { "source": "/plugins/easy-pitch", "destination": "/plugins/easy-pitch.html" },
    { "source": "/plugin/omni", "destination": "/plugins/omni.html" },
    { "source": "/plugins/omni", "destination": "/plugins/omni.html" },
    { "source": "/plugin/vocal-preset", "destination": "/plugins/vocal-preset.html" },
    { "source": "/plugins/vocal-preset", "destination": "/plugins/vocal-preset.html" },
    { "source": "/plugin/star-chain", "destination": "/plugins/star-chain.html" },
    { "source": "/plugins/star-chain", "destination": "/plugins/star-chain.html" },
    { "source": "/plugin/checkout", "destination": "/plugins/checkout.html" },
    { "source": "/plugins/checkout", "destination": "/plugins/checkout.html" },
    { "source": "/plugin/cassette", "destination": "/plugins/cassette.html" },
    { "source": "/plugins/cassette", "destination": "/plugins/cassette.html" },
    { "source": "/list/lista-de-espera", "destination": "/list/lista-de-espera.html" },
    { "source": "/kanban", "destination": "/metodo/etapa-inicial/metodo-kanban/kanban.html" },
    { "source": "/kanban-offszn", "destination": "/metodo/etapa-inicial/metodo-kanban/kanban-offszn.html" },
    { "source": "/kanban-upc", "destination": "/metodo/etapa-inicial/metodo-kanban/kanban-upc.html" },
    { "source": "/kanban-pendientes", "destination": "/metodo/etapa-inicial/metodo-kanban/kanban-pendientes.html" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
