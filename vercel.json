{
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.html,*.txt,*.xml,_headers,favicon*,css/**,script/**,components/**,images/**,libs/**,pages/**,plugin*/**,legal/**,metodo/**,owner/**,recursos/**,upload/**,ayuda/**,willie*/**,cuenta/**,comunidad/**,store-builder/**,videos/**}",
      "excludeFiles": "{**/*.wav,**/*.docx,**/*.psd,**/*.map,**/*.pkg,videos/video_para_modal.mp4}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
