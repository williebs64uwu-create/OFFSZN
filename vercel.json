{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://offszn-hu18.onrender.com/api/:path*"
    },
    {
      "source": "/env.js",
      "destination": "https://offszn-hu18.onrender.com/env.js"
    },
    {
      "source": "/upload/:path*",
      "destination": "https://offszn-hu18.onrender.com/upload/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://offszn-hu18.onrender.com/images/:path*"
    },
    {
      "source": "/previews/:path*",
      "destination": "https://offszn-hu18.onrender.com/previews/:path*"
    },
    {
      "source": "/recursos/:path*",
      "destination": "https://offszn-hu18.onrender.com/recursos/:path*"
    },
    {
      "source": "/cuenta/:slug*",
      "destination": "/cuenta/:slug*.html"
    },
    {
      "source": "/pages/:slug*",
      "destination": "/pages/:slug*.html"
    },
    {
      "source": "/Gift-Cards",
      "destination": "/Gift-Cards.html"
    },
    {
      "source": "/account-settings",
      "destination": "/account-settings.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/favoritos",
      "destination": "/favoritos.html"
    },
    {
      "source": "/feed",
      "destination": "/feed.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/mis-compras",
      "destination": "/mis-compras.html"
    },
    {
      "source": "/subir-kit",
      "destination": "/subir-kit.html"
    },
    {
      "source": "/preferencias",
      "destination": "/preferencias.html"
    },
    {
      "source": "/transacciones",
      "destination": "/transacciones.html"
    },
    {
      "source": "/explorar",
      "destination": "/explorar.html"
    },
    {
      "source": "/register",
      "destination": "/pages/register.html"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/plugins/all",
      "destination": "/plugins/all.html"
    },
    {
      "source": "/plugins/easy-mix",
      "destination": "/plugins/easy-mix.html"
    },
    {
      "source": "/plugins/easy-master",
      "destination": "/plugins/easy-master.html"
    },
    {
      "source": "/plugins/easy-master-mockup",
      "destination": "/plugins/easy-master-mockup.html"
    },
    {
      "source": "/plugins/easy-mix-mockup",
      "destination": "/plugins/easy-mix-mockup.html"
    },
    {
      "source": "/plugins/converter",
      "destination": "/plugins/vst-plugins.html"
    },
    {
      "source": "/plugins/x-flow-analyzer",
      "destination": "/plugins/x-flow-analyzer.html"
    },
    {
      "source": "/p/:splat*",
      "destination": "/producto.html"
    },
    {
      "source": "/beat/:splat*",
      "destination": "/producto.html"
    },
    {
      "source": "/drumkit/:splat*",
      "destination": "/producto.html"
    },
    {
      "source": "/loopkit/:splat*",
      "destination": "/producto.html"
    },
    {
      "source": "/recurso/:splat*",
      "destination": "/producto.html"
    },
    {
      "source": "/servicio/:splat*",
      "destination": "/servicio.html"
    },
    {
      "source": "/@:username",
      "destination": "/perfil-publico.html"
    }
  ]
}
