{
  "functions": {
    "api/index.js": {
      "includeFiles": "{_headers,*.html,favicon*,robots.txt,sitemap.xml,c*/**,script/**,libs/**,images/**,legal/**,owner/**,pages/**,plugin*/**,recursos/**,store-builder/**,upload/**,willie*/**,ayuda/**,server/**,music*/**,videos/video-offsz.mp4}",
      "excludeFiles": "{**/*.wav,**/*.docx,**/*.psd,**/*.map}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
