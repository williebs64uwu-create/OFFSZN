     border-radius: 4px;
     color: #666;

     /* Fix for layout shift (Grow effect) */
     opacity: 0;
     pointer-events: none;
     display: block;
     /* Always take up space */

     font-size: 1.1rem !important;
     transition: opacity 0.2s, background 0.2s, color 0.2s;
 }

 .recent-item:hover .history-delete-btn {
     opacity: 1;
