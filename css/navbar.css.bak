 /* Search Overlay */
 #search-overlay {
     position: fixed;
     top: 0;
     left: 0;
     width: 100vw;
     height: 100vh;
     background: rgba(0, 0, 0, 0.5);
     z-index: 999;
     display: none;
     backdrop-filter: blur(2px);
     transition: opacity 0.3s;
 }

 /* Search Results & Skeleton */
 .search-result-item {
     display: flex;
     align-items: center;
     gap: 10px;
     padding: 8px;
     border-radius: 8px;
     cursor: pointer;
     transition: background 0.2s;
 }

 .search-result-item:hover,
 .search-result-item.selected {
     background: rgba(255, 255, 255, 0.08);
 }

 .result-img {
     width: 32px;
